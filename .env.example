# Optional: Firebase web config for local builds (or edit src/firebase-config.ts).
# Without it the app runs in on-device demo mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Public web address used in share links, e.g. https://quidsin.app
VITE_PUBLIC_URL=
